# Copy to .env (or set these in your hosting dashboard). NEVER commit real values.

# --- Bot tokens: set at least one -------------------------------------------------
TELEGRAM_BOT_TOKEN=
BALE_BOT_TOKEN=

# --- AI providers: set at least one (both enables automatic failover) -------------
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Several keys per provider (optional) -----------------------------------------
# Comma-separated; spaces and empty items are ignored and duplicates are removed. They are
# merged with the singular variables, so an existing GROQ_API_KEY keeps working as it is.
# With two or more keys, requests rotate round-robin; a key that is rate limited, times out
# or fails is skipped for a while. Example (placeholders): GROQ_API_KEYS=key-a, key-b, key-c
GROQ_API_KEYS=
GEMINI_API_KEYS=
TAVILY_API_KEYS=

# --- Optional features ------------------------------------------------------------
# Web search, link summaries and /read. Without it search falls back to a Google News RSS feed.
TAVILY_API_KEY=

# --- Access control ---------------------------------------------------------------
# Comma-separated numeric user IDs. Empty = anyone can use the bot.
# Tip: message the bot from an unlisted account; Bale replies with the numeric ID to add.
ALLOWED_USERS=

# --- Optional tuning --------------------------------------------------------------
# MODEL_FAST=qwen/qwen3.8-27b
# MODEL_SMART=openai/gpt-oss-120b
# MODEL_GEMINI=gemini-3.5-flash-lite
# MODEL_WHISPER=whisper-large-v3-turbo
# WHISPER_LANGUAGE=fa          # empty string = auto-detect
# PORT=8080

# Key rotation (only matters with 2+ keys per provider). Seconds unless noted; defaults shown.
# KEY_MAX_ATTEMPTS=3                # keys tried for one request
# KEY_RETRY_BUDGET_SECONDS=90       # no further key is tried once a request has taken this long
# KEY_COOLDOWN_RATE_LIMIT=60        # 429 / quota without a Retry-After header
# KEY_COOLDOWN_RATE_LIMIT_MAX=300   # cap applied to a Retry-After header
# KEY_COOLDOWN_TRANSIENT=15         # timeout, connection error, 5xx
# KEY_COOLDOWN_AUTH=3600            # 401 / 403
